// CRM Lead Dashboard — schéma Prisma (provider MySQL / MariaDB)
//
// Conventions :
//  - PII des prospects (email, téléphone) + credentials SMTP/IMAP + secret TOTP
//    stockés chiffrés AES-256-GCM dans des champs `Bytes` suffixés `Enc`
//    (IV + tag inclus, voir lib/crypto.ts).
//  - `emailHash` = HMAC-SHA256 de l'email normalisé → recherche / dédoublonnage.
//  - Soft delete via `deletedAt` sur `leads`. Hard delete RGPD via transaction (CRM-072).
//  - Pas de Redis : la file de tâches asynchrones est la table `jobs` (model Job),
//    consommée par le worker en polling (apps/worker).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  COMMERCIAL
  LECTEUR
}

enum LeadStatus {
  NOUVEAU
  CONTACTE
  QUALIFIE
  EN_DISCUSSION
  CONVERTI
  PERDU
}

enum EmailStatus {
  UNKNOWN
  VALID
  SOFT_BOUNCE
  HARD_BOUNCE
  UNSUBSCRIBED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  DONE
  CANCELLED
}

enum EmailEventType {
  SENT
  DELIVERED
  OPEN
  CLICK
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  REPLIED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ──────────────────────────────────────────────────────────────
// Utilisateurs / sécurité
// ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(LECTEUR)
  teamId        String?
  totpSecretEnc Bytes?
  twoFactorOn   Boolean   @default(false)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  invitedAt     DateTime?
  inviteToken   String?
  tokenVersion  Int       @default(0)
  // Clé API OpenAI personnelle (AES-256-GCM), jamais exposée au client
  openAiApiKeyEnc Bytes?
  openAiModel     String?   @default("gpt-4o-mini")
  openAiEnabled   Boolean   @default(false)
  // Texte libre : consignes, offres, ton — lu par l'IA pour campagnes et auto-réponses.
  openAiKnowledgeText  String?  @db.Text
  // Fichiers Markdown importés [{ id, name, content, createdAt }].
  openAiKnowledgeDocs  Json     @default("[]")
  // Auto-répondeur IA (par utilisateur) : off | draft | auto
  autoResponderMode       String  @default("off")
  autoResponderMeetingUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  team          Team?          @relation(fields: [teamId], references: [id])
  assignedLeads Lead[]         @relation("LeadAssignee")
  leadViews     LeadView[]
  importJobs    ImportJob[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  templateBlocks TemplateBlock[]
  openAiUsageLogs OpenAiUsageLog[]
  leadNotes       LeadNote[]
  leadDocuments   LeadDocument[]

  @@index([teamId])
}

// Consommation OpenAI par utilisateur (tokens par appel API).
model OpenAiUsageLog {
  id               String   @id @default(cuid())
  userId           String
  feature          String
  model            String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float    @default(0)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members User[]
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  ip         String?
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

// ──────────────────────────────────────────────────────────────
// Leads
// ──────────────────────────────────────────────────────────────

model Lead {
  id          String      @id @default(cuid())
  emailEnc    Bytes?
  emailHash   String?
  phoneEnc    Bytes?
  firstName   String?
  lastName    String?
  company     String?
  website     String?
  sector      String?
  city        String?
  country     String?
  source      String?
  status      LeadStatus  @default(NOUVEAU)
  emailStatus EmailStatus @default(UNKNOWN)
  score       Int         @default(0)
  tags        Json        @default("[]")
  notes       String?     @db.Text
  businessPotentialEur Decimal? @db.Decimal(14, 2) // potentiel commercial EUR
  assignedToId String?
  pipelineStageId String?
  enrichment  Json?
  lastActionAt DateTime?
  lastReplyAt DateTime?
  customFields Json?
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  assignedTo     User?            @relation("LeadAssignee", fields: [assignedToId], references: [id])
  pipelineStage  PipelineStage?   @relation(fields: [pipelineStageId], references: [id])
  history        LeadHistory[]
  leadNotes      LeadNote[]
  documents      LeadDocument[]
  pipeline       LeadPipeline?
  inboxMessages  InboxMessage[]
  emailEvents    EmailEvent[]
  sequenceLeads  SequenceLead[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([score(sort: Desc)])
  @@index([pipelineStageId])
  @@fulltext([firstName, lastName, company, notes])
}

model LeadHistory {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId, createdAt])
}

// Notes horodatées sur un lead avec base légale RGPD associée.
model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  userId     String?
  content    String   @db.Text
  legalBasis String?  @db.VarChar(64) // base légale RGPD
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
}

// Documents joints à un lead (stockage fichier local).
model LeadDocument {
  id          String   @id @default(cuid())
  leadId      String
  userId      String?
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String
  createdAt   DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId, createdAt])
}

model LeadView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  columns   Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
}

model Blacklist {
  id        String   @id @default(cuid())
  emailHash String   @unique
  reason    String?
  erasedBy  String?
  createdAt DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────
// Pipeline / Kanban
// ──────────────────────────────────────────────────────────────

model PipelineStage {
  id        String   @id @default(cuid())
  name      String
  order     Int
  color     String?
  createdAt DateTime @default(now())

  leads        Lead[]
  leadPipeline LeadPipeline[]
}

model LeadPipeline {
  id        String   @id @default(cuid())
  leadId    String   @unique
  stageId   String
  position  Int      @default(0)
  enteredAt DateTime @default(now())

  lead  Lead          @relation(fields: [leadId], references: [id])
  stage PipelineStage @relation(fields: [stageId], references: [id])

  @@index([stageId, position])
}

// ──────────────────────────────────────────────────────────────
// Emailing / campagnes
// ──────────────────────────────────────────────────────────────

model SmtpConfig {
  id               String   @id @default(cuid())
  label            String
  host             String
  port             Int
  loginEnc         Bytes
  passwordEnc      Bytes
  fromName         String?
  fromEmail        String?
  dailyLimit       Int      @default(200)
  sentToday        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  // OAuth Microsoft 365
  oauthProvider    String?  // "microsoft" | null
  oauthTenantId    String?
  oauthClientId    String?
  oauthClientSecretEnc Bytes?
  oauthRefreshTokenEnc Bytes?
  oauthMailSender  String?

  campaigns Campaign[]
}

model ImapConfig {
  id               String    @id @default(cuid())
  label            String
  host             String
  port             Int
  loginEnc         Bytes
  passwordEnc      Bytes
  isActive         Boolean   @default(true)
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
  // OAuth Microsoft 365
  oauthProvider    String?   // "microsoft" | null
  oauthTenantId    String?
  oauthClientId    String?
  oauthClientSecretEnc Bytes?
  oauthRefreshTokenEnc Bytes?
  oauthMailbox     String?
}

model Template {
  id                     String   @id @default(cuid())
  name                   String
  category               String?
  subject                String
  bodyHtml               String   @db.Text
  variables              Json     @default("[]")
  isPreset               Boolean  @default(false)
  isPublic               Boolean  @default(true)
  includeUnsubscribeLink Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  campaigns Campaign[]
}

model TemplateBlock {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  htmlContent String   @db.Text
  variables   Json     @default("[]")
  isPublic    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id])

  @@index([createdById])
}

model Segment {
  id        String   @id @default(cuid())
  name      String
  filters   Json
  createdAt DateTime @default(now())

  campaigns Campaign[]
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  status      CampaignStatus @default(DRAFT)
  templateId  String?
  segmentId   String?
  smtpConfigId String?
  subject     String?
  scheduledAt DateTime?
  dailyLimit  Int?
  stats       Json?
  config      Json?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  template   Template?    @relation(fields: [templateId], references: [id])
  segment    Segment?     @relation(fields: [segmentId], references: [id])
  smtpConfig SmtpConfig?  @relation(fields: [smtpConfigId], references: [id])
  emailEvents EmailEvent[]
  sequences  Sequence[]

  @@index([templateId])
  @@index([segmentId])
  @@index([smtpConfigId])
}

model EmailEvent {
  id         String         @id @default(cuid())
  campaignId String?
  leadId     String?
  sequenceId String?
  eventType  EmailEventType
  token      String?
  url        String?        @db.Text
  meta       Json?
  occurredAt DateTime       @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])

  @@index([campaignId, eventType, occurredAt])
  @@index([leadId, occurredAt])
}

// ──────────────────────────────────────────────────────────────
// Réponses / inbox
// ──────────────────────────────────────────────────────────────

model InboxMessage {
  id          String   @id @default(cuid())
  leadId      String?
  messageId   String
  inReplyTo   String?
  direction   String
  fromEnc     Bytes
  toEnc       Bytes
  subject     String?
  bodyText    String?  @db.Text
  bodyHtml    String?  @db.Text
  category    String?
  isAutoReply Boolean  @default(false)
  isRead      Boolean  @default(false)
  receivedAt  DateTime @default(now())
  deletedAt   DateTime?

  lead Lead? @relation(fields: [leadId], references: [id])

  @@index([leadId, receivedAt])
  @@index([messageId])
}

// ──────────────────────────────────────────────────────────────
// Relances / séquences
// ──────────────────────────────────────────────────────────────

model Sequence {
  id         String   @id @default(cuid())
  name       String
  steps      Json
  maxSteps   Int?
  isPaused   Boolean  @default(false)
  campaignId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sequenceLeads SequenceLead[]

  @@index([campaignId])
}

model SequenceLead {
  id           String    @id @default(cuid())
  sequenceId   String
  leadId       String
  currentStep  Int       @default(0)
  nextSendAt   DateTime?
  sentCount    Int       @default(0)
  status       String    @default("active")
  stoppedReason String?
  createdAt    DateTime  @default(now())

  sequence Sequence @relation(fields: [sequenceId], references: [id])
  lead     Lead     @relation(fields: [leadId], references: [id])

  @@index([nextSendAt, status])
  @@index([sequenceId, status])
  @@index([leadId])
}

// ──────────────────────────────────────────────────────────────
// Import
// ──────────────────────────────────────────────────────────────

model ImportJob {
  id            String   @id @default(cuid())
  userId        String
  fileName      String
  filePath      String?
  mapping       Json?
  totalRows     Int      @default(0)
  importedRows  Int      @default(0)
  duplicateRows Int      @default(0)
  errorRows     Int      @default(0)
  status        String   @default("pending")
  errorReport   String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────
// Intégrations / divers
// ──────────────────────────────────────────────────────────────

model WebhookOut {
  id        String   @id @default(cuid())
  url       String
  events    Json     @default("[]")
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ApiCredit {
  id        String   @id @default(cuid())
  provider  String   @unique
  used      Int      @default(0)
  quota     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?  @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json?
  status      JobStatus @default(PENDING)
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  result      Json?
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt, priority])
  @@index([type, status])
}

// ──────────────────────────────────────────────────────────────
// Configuration (singleton par type)
// ──────────────────────────────────────────────────────────────

model ScoringConfig {
  id        String   @id
  weights   Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model RbacConfig {
  id        String   @id @default("default")
  matrix    Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model WorkerConfig {
  id               String   @id
  agendaTimezone   String   @default("UTC")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Organization {
  id        String   @id
  name      String
  plan      String   @default("standard")
  isActive  Boolean  @default(true)
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────
// Scraper (hors périmètre courant — défini pour conformité CDC)
// ──────────────────────────────────────────────────────────────

model ScrapingMission {
  id        String   @id @default(cuid())
  name      String
  config    Json
  schedule  String?
  status    String   @default("pending")
  logs      String?  @db.Text
  createdAt DateTime @default(now())
}

model ScrapedLeadBuffer {
  id        String   @id @default(cuid())
  missionId String
  emailHash String?
  raw       Json
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([missionId, status])
}
