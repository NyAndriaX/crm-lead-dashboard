// CRM Lead — schéma Prisma (provider MySQL 8)
//
// Conventions :
//  - Identifiants : `cuid()` (VARCHAR(191)), singletons de configuration à id fixe "default".
//  - PII des prospects (email, téléphone) + credentials SMTP/IMAP + secret TOTP
//    stockés chiffrés AES-256-GCM dans des colonnes `Bytes` (BLOB) suffixées `Enc`
//    (IV + tag inclus, voir lib/crypto.ts).
//  - `emailHash` = HMAC-SHA256 de l'email normalisé (64 hex) → recherche / dédoublonnage.
//  - Soft delete via `deletedAt` sur `leads`. Hard delete RGPD : clés étrangères
//    `ON DELETE CASCADE` sur l'historique, le pipeline et les séquences du lead.
//  - Listes (tags, variables, événements webhook) : colonnes JSON (tableaux de chaînes),
//    filtrées avec `array_contains`.
//  - Pas de Redis ni de MongoDB : la file de tâches asynchrones est la table `queue_jobs`
//    (model QueueJob), consommée par le worker avec `SELECT … FOR UPDATE SKIP LOCKED`
//    (voir packages/queue).
//  - Collation par défaut utf8mb4_0900_ai_ci : comparaisons insensibles à la casse et aux accents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  COMMERCIAL
  LECTEUR
}

enum LeadStatus {
  NOUVEAU
  CONTACTE
  QUALIFIE
  EN_DISCUSSION
  CONVERTI
  PERDU
}

enum EmailStatus {
  UNKNOWN
  VALID
  SOFT_BOUNCE
  HARD_BOUNCE
  UNSUBSCRIBED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  DONE
  CANCELLED
}

enum EmailEventType {
  SENT
  DELIVERED
  OPEN
  CLICK
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  REPLIED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// ──────────────────────────────────────────────────────────────
// Utilisateurs / sécurité
// ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique // email de connexion (compte interne, pas de la PII prospect)
  passwordHash  String    @db.VarChar(100) // bcrypt cost 12
  name          String
  role          Role      @default(LECTEUR)
  teamId        String?
  totpSecretEnc Bytes? // secret TOTP chiffré AES-256-GCM
  twoFactorOn   Boolean   @default(false)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  invitedAt     DateTime?
  inviteToken   String?   @db.VarChar(255)
  tokenVersion  Int       @default(0) // incrémenté au logout forcé → invalide les refresh tokens
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  team           Team?           @relation(fields: [teamId], references: [id])
  assignedLeads  Lead[]          @relation("LeadAssignee")
  leadViews      LeadView[]
  importJobs     ImportJob[]
  notifications  Notification[]
  templateBlocks TemplateBlock[]

  @@map("users")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members User[]

  @@map("teams")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(100) // ex: "lead.update", "campaign.send"
  entityType String?  @db.VarChar(64)
  entityId   String?  @db.VarChar(191)
  ip         String?  @db.VarChar(64)
  diff       Json?
  createdAt  DateTime @default(now()) // TTL index 12 mois (cf. bloc index)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("auditLogs")
}

// ──────────────────────────────────────────────────────────────
// Leads
// ──────────────────────────────────────────────────────────────

model Lead {
  id              String      @id @default(cuid())
  emailEnc        Bytes?      @db.Blob
  emailHash       String?     @db.VarChar(64) // HMAC-SHA256 — unicité gérée applicativement (null autorisés)
  phoneEnc        Bytes?      @db.Blob
  contactsEnc     Bytes?      @db.Blob // JSON chiffré : téléphones du site, email/ligne directe du décideur
  firstName       String?
  lastName        String?
  company         String?
  website         String?     @db.VarChar(2048)
  placeId         String?     @db.VarChar(255) // identifiant Google Maps (dédoublonnage des leads scrapés)
  sector          String?
  city            String?
  country         String?
  source          String?
  status          LeadStatus  @default(NOUVEAU)
  emailStatus     EmailStatus @default(UNKNOWN)
  score           Int         @default(0)
  tags            Json
  notes           String?     @db.Text
  assignedToId    String?
  pipelineStageId String?
  enrichment      Json? // firmographie / réseaux / actu — alimenté plus tard
  lastActionAt    DateTime?
  lastReplyAt     DateTime?
  customFields    Json?
  deletedAt       DateTime? // soft delete
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assignedTo    User?          @relation("LeadAssignee", fields: [assignedToId], references: [id])
  pipelineStage PipelineStage? @relation(fields: [pipelineStageId], references: [id])
  history       LeadHistory[]
  pipeline      LeadPipeline?
  inboxMessages InboxMessage[]
  emailEvents   EmailEvent[]
  sequenceLeads SequenceLead[]

  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([score(sort: Desc)])
  @@index([emailHash])
  @@index([placeId])
  @@index([deletedAt])
  @@map("leads")
}

model LeadHistory {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  type      String   @db.VarChar(64) // "status_change" | "note" | "email_sent" | "assigned" | ...
  payload   Json?
  createdAt DateTime @default(now()) // TTL index 12 mois

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("leadHistory")
}

model LeadView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  columns   Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leadViews")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  @@map("tags")
}

model Blacklist {
  id        String   @id @default(cuid())
  emailHash String   @unique @db.VarChar(64)
  reason    String? // "unsubscribe" | "hard_bounce" | "manual" | "complaint"
  createdAt DateTime @default(now())

  @@map("blacklist")
}

// ──────────────────────────────────────────────────────────────
// Pipeline / Kanban
// ──────────────────────────────────────────────────────────────

model PipelineStage {
  id        String   @id @default(cuid())
  name      String
  order     Int
  color     String?
  createdAt DateTime @default(now())

  leads        Lead[]
  leadPipeline LeadPipeline[]

  @@map("pipelineStages")
}

model LeadPipeline {
  id        String   @id @default(cuid())
  leadId    String   @unique
  stageId   String
  position  Int      @default(0)
  enteredAt DateTime @default(now())

  lead  Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage PipelineStage @relation(fields: [stageId], references: [id])

  @@index([stageId, position])
  @@map("leadPipeline")
}

// ──────────────────────────────────────────────────────────────
// Emailing / campagnes
// ──────────────────────────────────────────────────────────────

model SmtpConfig {
  id          String   @id @default(cuid())
  label       String
  host        String   @db.VarChar(255)
  port        Int
  loginEnc    Bytes
  passwordEnc Bytes
  fromName    String?
  fromEmail   String?
  dailyLimit  Int      @default(200)
  sentToday   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  campaigns Campaign[]

  @@map("smtpConfigs")
}

model ImapConfig {
  id          String    @id @default(cuid())
  label       String
  host        String    @db.VarChar(255)
  port        Int
  loginEnc    Bytes
  passwordEnc Bytes
  isActive    Boolean   @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("imapConfigs")
}

model Template {
  id        String   @id @default(cuid())
  name      String
  category  String?
  subject   String   @db.VarChar(998)
  bodyHtml  String   @db.LongText
  variables Json
  isPreset  Boolean  @default(false)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  @@map("templates")
}

model TemplateBlock {
  id          String   @id @default(cuid())
  name        String
  category    String // header, footer, cta, content, signature, etc.
  description String?  @db.Text
  htmlContent String   @db.LongText
  variables   Json
  isPublic    Boolean  @default(true) // visible par tous les utilisateurs
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id])

  @@map("templateBlocks")
}

model Segment {
  id        String   @id @default(cuid())
  name      String
  filters   Json
  createdAt DateTime @default(now())

  campaigns Campaign[]

  @@map("segments")
}

model Campaign {
  id           String         @id @default(cuid())
  name         String
  status       CampaignStatus @default(DRAFT)
  templateId   String?
  segmentId    String?
  smtpConfigId String?
  subject      String?        @db.VarChar(998)
  scheduledAt  DateTime?
  dailyLimit   Int?
  stats        Json? // compteurs dénormalisés (sent/open/click/...)
  /// Options M-06→M-14 : throttleMinDelayMs, bodyHtmlOverride, ab{...}, warmup{...}, sendOffset, etc.
  config       Json?
  createdById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  template    Template?    @relation(fields: [templateId], references: [id])
  segment     Segment?     @relation(fields: [segmentId], references: [id])
  smtpConfig  SmtpConfig?  @relation(fields: [smtpConfigId], references: [id])
  emailEvents EmailEvent[]

  @@map("campaigns")
}

model EmailEvent {
  id         String         @id @default(cuid())
  campaignId String?
  leadId     String?
  sequenceId String?
  eventType  EmailEventType
  token      String?        @db.VarChar(512) // token de tracking (pixel / clic / unsubscribe)
  url        String?        @db.Text // URL cliquée (eventType=CLICK)
  meta       Json?
  occurredAt DateTime       @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([campaignId, eventType, occurredAt])
  @@index([leadId, occurredAt])
  @@map("emailEvents")
}

// ──────────────────────────────────────────────────────────────
// Réponses / inbox
// ──────────────────────────────────────────────────────────────

model InboxMessage {
  id          String   @id @default(cuid())
  leadId      String?
  messageId   String   @db.VarChar(512) // Message-ID SMTP (threading)
  inReplyTo   String?  @db.VarChar(512)
  direction   String // "inbound" | "outbound"
  fromEnc     Bytes    @db.Blob
  toEnc       Bytes    @db.Blob
  subject     String?  @db.VarChar(998)
  bodyText    String?  @db.LongText
  bodyHtml    String?  @db.LongText
  category    String? // "interesse" | "pas_interesse" | "hors_sujet" | "rappel" | "auto_reply"
  isAutoReply Boolean  @default(false)
  isRead      Boolean  @default(false)
  receivedAt  DateTime @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, receivedAt])
  @@index([messageId])
  @@map("inboxMessages")
}

// ──────────────────────────────────────────────────────────────
// Relances / séquences
// ──────────────────────────────────────────────────────────────

model Sequence {
  id        String   @id @default(cuid())
  name      String
  steps     Json // [{ delayDays, templateId, stopOnReply }]
  maxSteps  Int?
  isPaused  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sequenceLeads SequenceLead[]

  @@map("sequences")
}

model SequenceLead {
  id            String    @id @default(cuid())
  sequenceId    String
  leadId        String
  currentStep   Int       @default(0)
  nextSendAt    DateTime?
  sentCount     Int       @default(0)
  status        String    @default("active") // "active" | "paused" | "stopped" | "completed"
  stoppedReason String?   @db.Text
  createdAt     DateTime  @default(now())

  sequence Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([nextSendAt, status])
  @@index([sequenceId, status])
  @@map("sequenceLeads")
}

// ──────────────────────────────────────────────────────────────
// Import
// ──────────────────────────────────────────────────────────────

model ImportJob {
  id            String   @id @default(cuid())
  userId        String
  fileName      String   @db.VarChar(255)
  filePath      String?  @db.VarChar(1024)
  mapping       Json?
  totalRows     Int      @default(0)
  importedRows  Int      @default(0)
  duplicateRows Int      @default(0)
  errorRows     Int      @default(0) // lignes rejetées (colonne obligatoire vide, format invalide, erreur)
  cleanedRows   Int      @default(0) // lignes importées après nettoyage d'une valeur invalide (I-07)
  status        String   @default("pending") // pending | running | done | failed
  errorReport   String?  @db.LongText // rapport texte des lignes rejetées
  report        Json? // rapport détaillé : { issues[{ row, action, field, reason }], requiredFields, assignment } (I-03/I-07/I-09)
  createdAt     DateTime @default(now()) // rétention 90 jours (TTL index)

  user User @relation(fields: [userId], references: [id])

  @@map("importJobs")
}

// ──────────────────────────────────────────────────────────────
// Intégrations / divers
// ──────────────────────────────────────────────────────────────

model WebhookOut {
  id        String   @id @default(cuid())
  url       String   @db.VarChar(2048)
  events    Json // newLead | leadReplied | leadStatusChanged | campaignDone | unsubscribe
  secret    String // secret HMAC
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("webhooksOut")
}

model ApiCredit {
  id        String   @id @default(cuid())
  provider  String   @unique // hunter | apollo | pappers | clearbit | googlePlaces ...
  used      Int      @default(0)
  quota     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("apiCredits")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String   @db.VarChar(255)
  body      String?  @db.Text
  link      String?  @db.VarChar(1024)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// File de tâches asynchrones (remplace @hokify/agenda / MongoDB). Écrite par l'API web et le
// worker (`enqueue`), consommée par le worker avec `SELECT … FOR UPDATE SKIP LOCKED`.
//  - `uniqueKey` : déduplication (jobs récurrents "recurring:<nom>", un seul exemplaire).
//  - `repeatEveryMs` : job récurrent, replanifié à `now + repeatEveryMs` après chaque exécution.
//  - Un job RUNNING dont `lockedUntil` est dépassé est considéré abandonné et redevient éligible.
model QueueJob {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(64) // "campaign-send" | "imap-sync" | "scraping-run" | ...
  payload        Json?
  status         JobStatus @default(PENDING)
  priority       Int       @default(0) // plus grand = plus prioritaire
  runAt          DateTime  @default(now()) @db.DateTime(3)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(1)
  uniqueKey      String?   @unique @db.VarChar(191)
  repeatEveryMs  Int?
  lockedBy       String?   @db.VarChar(100)
  lockedUntil    DateTime? @db.DateTime(3)
  lastRunAt      DateTime? @db.DateTime(3)
  lastFinishedAt DateTime? @db.DateTime(3)
  lastError      String?   @db.Text
  result         Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt, priority])
  @@index([name, status])
  @@map("queue_jobs")
}

// ──────────────────────────────────────────────────────────────
// Configuration (singleton par type)
// ──────────────────────────────────────────────────────────────

// Document singleton (id = "default") stockant les poids de scoring configurés via l'UI admin.
// Si absent, le scoring utilise les DEFAULT_WEIGHTS hardcodés dans lib/scoring.ts.
model ScoringConfig {
  id        String   @id // valeur fixe : "default"
  weights   Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("scoringConfig")
}

// Réglages du worker (singleton id = "default").
/// Fournisseur d'IA choisi par l'administrateur (singleton id = "default").
model AiConfig {
  id        String   @id // valeur fixe : "default"
  enabled   Boolean  @default(true)
  provider  String   @default("claude-skills") @db.VarChar(40) // claude-skills | openai | deepseek | mistral | gemini | ollama | openai-compatible
  model     String?  @db.VarChar(120) // modèle de rédaction (ignoré pour claude-skills)
  fastModel String?  @db.VarChar(120) // modèle rapide pour les tâches en volume (optionnel)
  baseUrl   String?  @db.VarChar(255) // point d'accès (Ollama, service compatible OpenAI)
  apiKeyEnc Bytes?   @db.Blob // clé d'API ou jeton CLAUDE_CODE_OAUTH_TOKEN, chiffré AES-256-GCM
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("aiConfig")
}

// INT-03 — Clés des fournisseurs d'enrichissement (Hunter.io, Dropcontact, Pappers…) réglées dans
// Configuration › Enrichissement. Clé chiffrée AES-256-GCM comme aiConfig ; sans ligne en base,
// repli sur la variable d'environnement du fournisseur (HUNTER_API_KEY, DROPCONTACT_API_KEY…).
model EnrichmentProviderKey {
  provider  String   @id @db.VarChar(40) // hunter | dropcontact | pappers | recherche-entreprises
  enabled   Boolean  @default(true)
  apiKeyEnc Bytes?   @db.Blob // clé d'API chiffrée, jamais renvoyée au navigateur
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("enrichmentProviderKeys")
}

model WorkerConfig {
  id             String   @id // "default"
  agendaTimezone String   @default("UTC") // IANA, ex. Europe/Paris — fuseau du worker (planification & logs)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("workerConfig")
}

// T-02 — Multi-tenant (optionnel). Scaffold "single-tenant par défaut" :
// l'organisation `default` représente l'instance courante. La vraie
// isolation par tenant (organizationId sur Lead/Campaign/…) est une
// évolution phase 2 documentée dans docs/architecture/multi-tenant.md ;
// on pose ici le modèle + le helper pour ne pas bloquer cette évolution.
model Organization {
  id        String   @id // "default" tant que single-tenant
  name      String
  plan      String   @default("standard") // standard | pro | enterprise
  isActive  Boolean  @default(true)
  settings  Json? // overrides éventuels (limites, branding…)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

// ──────────────────────────────────────────────────────────────
// Scraping (missions exécutées par le worker → apps/scraper)
// ──────────────────────────────────────────────────────────────

model ScrapingMission {
  id        String   @id @default(cuid())
  name      String
  config    Json // mots-clés, localisation, sources, taille, langue...
  schedule  String?  @db.VarChar(255) // planification récurrente
  status    String   @default("pending")
  logs      String?  @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // dernière activité (lancement, statut, journal)

  @@map("scrapingMissions")
}

model ScrapedLeadBuffer {
  id        String   @id @default(cuid())
  missionId String
  emailHash String?  @db.VarChar(64)
  raw       Json
  status    String   @default("pending") // pending | accepted | rejected
  createdAt DateTime @default(now())

  @@index([missionId, status])
  @@map("scrapedLeadsBuffer")
}

// ──────────────────────────────────────────────────────────────
// Analytique — envoi planifié des rapports par email (AN-05)
// ──────────────────────────────────────────────────────────────

/// Envoi récurrent du rapport d'analytique (PDF joint) à une liste de destinataires internes.
/// Traité par le job récurrent `report-schedule-tick` (@crm/jobs) qui envoie les plans dont `nextRunAt` est échu.
model ReportSchedule {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(120)
  enabled      Boolean   @default(true)
  frequency    String    @default("weekly") @db.VarChar(10) // daily | weekly | monthly
  hour         Int       @default(8) // heure d'envoi (0-23, fuseau du worker)
  dayOfWeek    Int?      // 1 = lundi … 7 = dimanche (weekly)
  dayOfMonth   Int?      // 1-28 (monthly)
  period       String    @default("30d") @db.VarChar(5) // période du rapport : 7d | 30d | 90d | ytd | all
  recipients   Json // adresses email des destinataires internes (string[])
  includeXlsx  Boolean   @default(false) // joindre aussi le classeur Excel
  smtpConfigId String? // compte d'envoi ; null = SMTP de secours (.env) puis premier compte actif
  nextRunAt    DateTime?
  lastSentAt   DateTime?
  lastError    String?   @db.Text
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([enabled, nextRunAt])
  @@map("reportSchedules")
}
