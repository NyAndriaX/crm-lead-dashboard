# Reverse proxy — CRM Lead. ${DOMAIN} est substitué au démarrage par l'image nginx officielle.
# Le certificat est créé une première fois par deploy/scripts/init-ssl.sh, puis renouvelé
# par le service certbot.

upstream crm_web {
    server web:3000;
    keepalive 16;
}

# HTTP : challenge ACME + redirection vers HTTPS
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 1024;

    # Import CSV/XLSX jusqu'à 10 Mo (CRM-021)
    client_max_body_size 15m;

    # Limitation de débit sur l'authentification (anti brute-force)
    location /api/auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://crm_web;
        include /etc/nginx/conf.d/proxy_params.inc;
    }

    location /_next/static/ {
        proxy_pass http://crm_web;
        include /etc/nginx/conf.d/proxy_params.inc;
        expires 365d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://crm_web;
        include /etc/nginx/conf.d/proxy_params.inc;
    }
}
