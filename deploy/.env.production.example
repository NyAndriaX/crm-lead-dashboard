# ──────────────────────────────────────────────────────────────
# CRM Lead — environnement de PRODUCTION (serveur unique)
# cp deploy/.env.production.example deploy/.env   puis compléter.
# Secrets : `openssl rand -hex 32` (hexadécimal → aucun caractère à échapper dans les URL).
# DATABASE_URL, APP_BASE_URL, SCRAPER_API_URL sont construits par docker-compose.yml.
# ──────────────────────────────────────────────────────────────

# --- Domaine public (DNS A → IP du serveur) ---
DOMAIN=crm.exemple.fr
LETSENCRYPT_EMAIL=ops@exemple.fr

# --- MySQL ---
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Premier administrateur (créé au 1er déploiement, jamais réécrit ensuite) ---
ADMIN_EMAIL=ops@exemple.fr
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# --- Sécurité applicative ---
AUTH_JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
PII_ENCRYPTION_KEY=          # 64 caractères hex — À SAUVEGARDER : sa perte = perte des données chiffrées
EMAIL_HASH_SECRET=
INTERNAL_API_TOKEN=

# --- Tâches de fond (dans le conteneur web) ---
RUN_JOBS=true
WORKER_TIMEZONE=Europe/Paris
WORKER_CONCURRENCY=5

# --- Scraper (conteneur interne) ---
SCRAPING_LIVE=true
SCRAPER_API_KEY=             # partagé web ↔ scraper
SCRAPER_TIMEOUT_MS=0
HEADLESS=true
LOCALE=fr-FR
EMAIL_CONCURRENCY=3
HOMEPAGE_ENRICHMENT=true

# --- IA ---
# Le fournisseur (Claude Skills, OpenAI, DeepSeek, Mistral, Gemini, Ollama…) se choisit dans l'application :
# Configuration › Intelligence artificielle (clés et jeton stockés chiffrés en base).
# Les variables ci-dessous ne servent que de valeur initiale tant que l'administrateur n'a rien enregistré :
# Claude Skills via le CLI Claude Code, jeton généré une fois sur un poste connecté (`claude setup-token`).
CLAUDE_SKILLS_ENABLED=true
CLAUDE_CODE_OAUTH_TOKEN=
AI_MAX_CONCURRENCY=2
AI_TIMEOUT_MS=120000

# --- Auto-réponse (off | draft | auto) ---
AUTO_RESPONDER_MODE=draft
AUTO_RESPONDER_MEETING_URL=

# --- SMTP de secours (emails système ; les comptes métier se configurent dans l'app) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="CRM Lead"
SMTP_FROM_EMAIL=
