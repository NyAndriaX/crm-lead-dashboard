# Copier : cp .env.example .env

HEADLESS=true
LOG_LEVEL=INFO
LOCALE=fr-FR
DEFAULT_MAX_RESULTS=20
NAV_TIMEOUT_MS=30000
EMAIL_NAV_TIMEOUT_MS=15000
EMAIL_PAGE_WAIT_MS=2000
EMAIL_CONCURRENCY=3
HOMEPAGE_ENRICHMENT=true

# Résumé IA de la page d'accueil (optionnel) — skill Claude `crm-site-summary`
# exécuté par le CLI Claude Code avec l'abonnement Claude, SANS clé API.
#   dev    : `claude login` sur la machine
#   docker : `claude setup-token` → CLAUDE_CODE_OAUTH_TOKEN
CLAUDE_SKILLS_ENABLED=false
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=haiku
CLAUDE_TIMEOUT_MS=120000
CLAUDE_MAX_CONCURRENCY=2

SCRAPER_TIMEOUT_MS=630000
PROXY=
