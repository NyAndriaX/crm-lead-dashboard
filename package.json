{
  "name": "crm-lead-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "CRM Lead Dashboard — monorepo (web + worker + db). Stack: Next.js 15 · Ant Design 5 · Prisma 5 · MongoDB 7 · Docker (sans Redis : file Agenda @hokify/agenda sur MongoDB).",
  "engines": {
    "node": ">=20.6.0",
    "yarn": ">=1.22.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -- yarn workspace @crm/web dev",
    "worker": "dotenv -e .env -- yarn workspace @crm/worker dev",
    "scraper": "bash ../CRM_LEAD_SCRAPER/run.sh",
    "dev:all": "dotenv -e .env -- node scripts/run-all.mjs dev",
    "dev:full": "dotenv -e .env -- node scripts/run-all.mjs dev --with-scraper",
    "build": "yarn workspaces run build",
    "start": "dotenv -e .env -- yarn workspace @crm/web start",
    "start:prod": "dotenv -e .env -- node scripts/start-standalone.mjs",
    "worker:prod": "dotenv -e .env -- yarn workspace @crm/worker start",
    "start:all": "dotenv -e .env -- node scripts/run-all.mjs prod",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspaces run typecheck",
    "test": "yarn workspaces run test",
    "db:generate": "yarn workspace @crm/db generate",
    "db:push": "dotenv -e .env -- yarn workspace @crm/db push",
    "db:reset": "dotenv -e .env -- yarn workspace @crm/db reset",
    "db:seed": "dotenv -e .env -- yarn workspace @crm/db seed",
    "db:init-prod": "dotenv -e .env -- yarn workspace @crm/db init-prod",
    "db:studio": "dotenv -e .env -- yarn workspace @crm/db studio"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.6.3"
  }
}
